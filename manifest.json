{
  "manifest_version": 3,
  "name": "ADHD Standalone Focus Check",
  "version": "1.0.0",
  "description": "A standalone client-side browser sensor that detects doomscrolling and intervenes with soft-block overlays.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "wss://extensi-adhd-websocket.onrender.com/*",
    "https://extensi-adhd-websocket.onrender.com/*",
    "wss://adhd-extension-c6xz-adhd-extension-c-mmxf.rivet.run/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content_loader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.css",
        "src/config.js",
        "src/content.js",
        "src/lib/qrcode.min.js",
        "src/lib/socket.io.min.js",
        "src/content/modules/domainMatcher.js",
        "src/content/modules/heuristicsEngine.js",
        "src/content/modules/overlayManager.js",
        "src/content/modules/softBlockOverlay.js",
        "src/content/modules/floatingPomodoroWidget.js",
        "src/content/modules/storageSync.js",
        "src/shared/constants.js",
        "src/shared/storageWrapper.js",
        "src/shared/pomodoroUtils.js"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "ADHD Standalone Focus Check"
  }
}
